@model IEnumerable<HShop.ViewModels.CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Thanh Toán</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="#">Trang</a></li>
        <li class="breadcrumb-item active text-white">Thanh toán</li>
    </ol>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Thông tin thanh toán</h1>

        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <h4>Vui lòng kiểm tra lại thông tin:</h4>
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <!-- FORM -->
        <form asp-action="Checkout" asp-controller="Cart" method="post">

            <!-- Hidden input FIX COD -->
            <input type="hidden" id="paymentMethod" name="payment" value="COD" />

            <div class="row g-5">
                <div class="col-md-12 col-lg-6 col-xl-7">

                    <div class="form-check my-3">
                        <input type="checkbox" name="GiongKhachHang"
                               class="form-check-input" id="GiongKhachHang" value="true">
                        <label class="form-check-label" for="GiongKhachHang">
                            Giống thông tin khách hàng?
                        </label>
                    </div>

                    <div class="form-item delivery-info">
                        <label class="form-label my-3">Người nhận hàng<sup>*</sup></label>
                        <input type="text" name="HoTen" class="form-control">
                    </div>

                    <div class="form-item delivery-info">
                        <label class="form-label my-3">Địa chỉ nhận hàng<sup>*</sup></label>
                        <input type="text" name="DiaChi" class="form-control"
                               placeholder="123 Lê Lợi, Quận 1">
                    </div>

                    <div class="form-item delivery-info">
                        <label class="form-label my-3">Điện thoại<sup>*</sup></label>
                        <input type="text" name="DienThoai" class="form-control">
                    </div>

                    <div class="form-item mt-3">
                        <textarea name="GhiChu" class="form-control"
                                  cols="30" rows="11" placeholder="Ghi chú"></textarea>
                    </div>

                    <!-- Nút COD -->
                    <input type="submit"
                           class="btn border-secondary text-uppercase text-primary w-100 mt-2"
                           value="Đặt hàng (COD)"
                           onclick="document.getElementById('paymentMethod').value='COD'; return true;">

                    <!-- Nút VNPay -->
                    <input type="submit"
                           class="btn border-secondary text-uppercase text-primary w-100 mt-2"
                           value="Thanh toán VNPay"
                           onclick="document.getElementById('paymentMethod').value='Thanh toán VNPay'; return true;">

                    <div id="paypal-button-container"
                         class="form-item mt-3" style="max-width:1000px;"></div>
                </div>


                <!-- RIGHT SIDE -->
                <div class="col-md-12 col-lg-6 col-xl-5">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Tên</th>
                                    <th>Giá</th>
                                    <th>Số lượng</th>
                                    <th>Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">
                                            <div class="d-flex align-items-center mt-2">
                                                <img src="~/Hinh/HangHoa/@item.Hinh"
                                                     class="img-fluid rounded-circle"
                                                     style="width: 90px; height: 90px;"
                                                     alt="@item.TenHH">
                                            </div>
                                        </th>
                                        <td class="py-5">@item.TenHH</td>
                                        <td class="py-5">$@item.DonGia</td>
                                        <td class="py-5">@item.SoLuong</td>
                                        <td class="py-5">@item.ThanhTien</td>
                                    </tr>
                                }

                                <!-- Tổng sau giảm -->
                                <tr>
                                    <td></td>
                                    <td class="py-5"><p class="mb-0 text-dark text-uppercase py-3">TỔNG CỘNG</p></td>
                                    <td></td>
                                    <td></td>
                                    <td class="py-5">
                                        <div class="py-3 border-bottom border-top">
                                            <p class="mb-0 text-dark">
                                                @{
                                                    double subtotal = Model.Sum(p => p.ThanhTien);
                                                    double discount = ViewBag.Discount ?? 0;
                                                    double final = subtotal - discount;
                                                    if (final < 0) final = 0;
                                                }
                                                @("$" + final.ToString("#,##0.00"))
                                            </p>
                                        </div>
                                    </td>
                                </tr>

                                @if (ViewBag.Discount != null)
                                {
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td class="py-5"><p class="mb-0 text-success py-3">Giảm giá</p></td>
                                        <td class="py-5">
                                            <div class="py-3 border-bottom border-top">
                                                <p class="mb-0 text-success">
                                                    -$@ViewBag.Discount.ToString("#,##0.00")
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                <tr>
                                    <td></td>
                                    <td class="py-5"><p class="mb-0 text-dark py-4">Vận chuyển</p></td>
                                    <td colspan="3" class="py-5">
                                        <div class="form-check text-start">
                                            <input type="checkbox" class="form-check-input bg-primary border-0">
                                            <label class="form-check-label">Miễn phí vận chuyển</label>
                                        </div>

                                        <div class="form-check text-start">
                                            <input type="checkbox" class="form-check-input bg-primary border-0">
                                            <label class="form-check-label">Cố định: 15.000đ</label>
                                        </div>

                                        <div class="form-check text-start">
                                            <input type="checkbox" class="form-check-input bg-primary border-0">
                                            <label class="form-check-label">Nhận tại cửa hàng: 8.000đ</label>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td></td>
                                    <td class="py-5">
                                        <p class="mb-0 text-dark text-uppercase py-3">TỔNG CỘNG</p>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td class="py-5">
                                        <div class="py-3 border-bottom border-top">
                                            <p class="mb-0 text-dark">
                                                @if (ViewBag.FinalTotal != null)
                                                {
                                                    @("$" + ViewBag.FinalTotal.ToString("#,##0.00"))
                                                }
                                                else
                                                {
                                                    @("$" + Model.Sum(p => p.ThanhTien).ToString("#,##0.00"))
                                                }
                                            </p>
                                        </div>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <!-- Payment Options -->
                    <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                        <div class="col-12">
                            <div class="form-check text-start my-3">
                                <input type="checkbox" class="form-check-input bg-primary border-0">
                                <label class="form-check-label">Chuyển khoản ngân hàng</label>
                            </div>
                            <p class="text-start text-dark">
                                Thực hiện thanh toán trực tiếp vào tài khoản ngân hàng của chúng tôi.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                        <div class="col-12">
                            <div class="form-check text-start my-3">
                                <input type="checkbox" class="form-check-input bg-primary border-0">
                                <label class="form-check-label">Thanh toán bằng séc</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                        <div class="col-12">
                            <div class="form-check text-start my-3">
                                <input type="checkbox" class="form-check-input bg-primary border-0">
                                <label class="form-check-label">Thanh toán khi nhận hàng (COD)</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                        <div class="col-12">
                            <div class="form-check text-start my-3">
                                <input type="checkbox" class="form-check-input bg-primary border-0">
                                <label class="form-check-label">Paypal</label>
                            </div>
                        </div>
                    </div>

                    <!-- PLACE ORDER BUTTON -->
                    <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                        <button type="submit"
                                class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary"
                                onclick="document.getElementById('paymentMethod').value='COD'; return true;">
                            Đặt hàng
                        </button>
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientdId"></script>

    <script>
        $(document).ready(function () {
            // Debug form submission
            $('form').on('submit', function(e) {
                console.log('Form is being submitted!');
                console.log('Payment method:', $('#paymentMethod').val());
                // Don't prevent default, let it submit naturally
            });

            $("#GiongKhachHang").change(function () {
                if ($(this).prop("checked")) {
                    $(".delivery-info").addClass("d-none");
                } else {
                    $(".delivery-info").removeClass("d-none");
                }
            });
        });
    </script>

    <script>
        // Only initialize PayPal if loaded successfully
        if (typeof paypal !== 'undefined') {
            paypal.Buttons({
                style: {
                    layout: 'vertical',
                    color: 'silver',
                    tagline: 'false'
                },
                createOrder: (data, actions) => {
                    return fetch("/Cart/create-paypal-order", { method: "post" })
                        .then(res => res.json())
                        .then(order => order.id)
                        .catch(err => alert(err.message));
                },
                onApprove: (data, actions) => {
                    return fetch(`/Cart/capture-paypal-order?orderId=${data.orderID}`,
                        { method: "post" })
                        .then(() => window.location.href = "/Cart/PaymentSuccess");
                }
            }).render('#paypal-button-container');
        }
    </script>
}
