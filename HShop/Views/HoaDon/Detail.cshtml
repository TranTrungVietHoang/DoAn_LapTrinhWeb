@model HShop.Data.HoaDon

<div class="container py-4">
    <h2 class="mb-4 text-primary">Chi tiết đơn hàng #@Model.MaHd</h2>

    <div class="mb-3">
        <strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy")<br />
        <strong>Trạng thái:</strong> @Model.MaTrangThaiNavigation?.TenTrangThai<br />
        <strong>Ghi chú:</strong> @Model.GhiChu
    </div>

    <h5>Danh sách sản phẩm</h5>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-secondary">
            <tr>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>

                
                <th>Mã giảm giá</th>

                <!-- Sửa lại cột giảm giá: hiển thị đúng tiền đã giảm -->
                <th>Giảm giá</th>

                <!-- Thành tiền sau giảm -->
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ct in Model.ChiTietHds)
            {
                var giamGia = ct.DiscountValue ?? 0;
                var thanhTien = (ct.DonGia * ct.SoLuong) - (double)giamGia;

                if (thanhTien < 0) thanhTien = 0;   // tránh âm

                <tr>
                    <td>@ct.MaHhNavigation?.TenHh</td>
                    <td>@ct.DonGia.ToString("N0") đ</td>
                    <td>@ct.SoLuong</td>

                    <!-- Mã giảm giá -->
                    <td>@ct.CouponCode</td>

                    <!-- Số tiền giảm -->
                    <td>@giamGia.ToString("N0") đ</td>

                    <!-- Thành tiền sau giảm -->
                    <td>@thanhTien.ToString("N0") đ</td>
                </tr>
            }

        </tbody>

    </table>

    <a asp-action="LichSuMuaHang" asp-controller="KhachHang" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Quay lại lịch sử
    </a>
</div>
