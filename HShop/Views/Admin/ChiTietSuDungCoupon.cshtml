@model IEnumerable<HShop.Data.CouponHistory>

@{
    ViewData["Title"] = "Lịch Sử Chi Tiết Sử Dụng Coupon";
    var historyData = ViewBag.HistoryWithCustomer as List<dynamic>;
}

<h1 class="text-primary mb-4">📋 Lịch Sử Chi Tiết Sử Dụng Coupon</h1>

<!-- Nút quay lại -->
<div class="mb-3">
    <a asp-action="QuanLyCoupon" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Quay lại Quản lý Coupon
    </a>
</div>

<!-- Bảng lịch sử chi tiết -->
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Mã Coupon</th>
                        <th>Customer ID</th>
                        <th>Đơn hàng</th>
                        <th>Ngày sử dụng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var history in Model)
                        {
                            <tr>
                                <td>@history.Id</td>
                                <td>
                                    <span class="badge bg-primary">@history.CouponCode</span>
                                </td>
                                <td>@history.CustomerId</td>
                                <td>
                                    @if (history.OrderId.HasValue && history.OrderId.Value > 0)
                                    {
                                        <a asp-controller="Admin" asp-action="QuanLyDonHang" class="btn btn-sm btn-outline-info">
                                            <i class="fa fa-shopping-cart"></i> #@history.OrderId.Value
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div>@history.UsedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="fa fa-inbox fa-3x mb-3"></i>
                                <p>Chưa có lịch sử sử dụng coupon nào</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tổng số bản ghi -->
@if (Model != null && Model.Any())
{
    <div class="mt-3 text-muted">
        <small><i class="fa fa-info-circle"></i> Tổng cộng: <strong>@Model.Count()</strong> lượt sử dụng</small>
    </div>
}

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }
</style>

<!-- Tổng số bản ghi -->
@if (historyData != null && historyData.Any())
{
    <div class="mt-3 text-muted">
        <small><i class="fa fa-info-circle"></i> Tổng cộng: <strong>@historyData.Count()</strong> lượt sử dụng</small>
    </div>
}

<style>
    .table tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }
</style>
