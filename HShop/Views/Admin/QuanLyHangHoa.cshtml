@model IEnumerable<HShop.Data.HangHoa>

@{
    ViewData["Title"] = "Quản lý hàng hóa";
    Layout = "_Layout"; // hoặc "_AdminLayout" nếu bạn có layout riêng cho admin
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">📦 Quản lý hàng hóa</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <!-- ✅ Nút thêm hàng hóa -->
    <div class="mb-3 text-end">
        <a href="/HangHoas/Create" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-circle"></i> Thêm hàng hóa
        </a>
    </div>

    <!-- ✅ Bảng danh sách hàng hóa -->
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-success text-center">
                <tr>
                    <th style="width:90px;">Mã HH</th>
                    <th style="width:120px;">Hình</th>
                    <th>Tên hàng hóa</th>
                    <th style="width:140px;">Đơn giá</th>
                    <th>Loại hàng</th>
                    <th>Nhà cung cấp</th>
                    <th style="width:220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.MaHh</td>
                            <td class="text-center">
                                <img src="~/Hinh/HangHoa/@(string.IsNullOrEmpty(item.Hinh) ? "no-image.png" : item.Hinh)"
                                     alt="@item.TenHh"
                                     width="80" height="80"
                                     class="rounded shadow-sm border" />
                            </td>
                            <td>@item.TenHh</td>
                            <td class="text-end">@item.DonGia?.ToString("N0") ₫</td>
                            <td>@item.MaLoaiNavigation?.TenLoai</td>
                            <td>@item.MaNccNavigation?.TenCongTy</td>

                            <td class="text-center">
                                <!-- ✅ Nút xem chi tiết -->
                                <a href="/HangHoas/Details/@item.MaHh"
                                   class="btn btn-info btn-sm me-1">
                                    <i class="bi bi-eye"></i> Xem
                                </a>

                                <!-- ✅ Nút sửa -->
                                <a href="/HangHoas/Edit/@item.MaHh"
                                   class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>

                                <!-- ✅ Nút xóa -->
                                <form action="/HangHoas/Delete/@item.MaHh"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Không có hàng hóa nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Hiển thị thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center mt-4">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center mt-4">
            @TempData["Error"]
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
