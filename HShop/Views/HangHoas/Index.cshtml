@model IEnumerable<HShop.Data.HangHoa>

@{
    ViewData["Title"] = "Danh sách hàng hóa";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success mb-0">📦 Danh sách hàng hóa</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left me-2"></i>Quay lại
            </a>
            <a asp-controller="Admin" asp-action="Create" class="btn btn-success">
                <i class="fa fa-plus me-2"></i>Thêm hàng hóa
            </a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover text-center align-middle shadow-sm">
        <thead class="table-success">
            <tr>
                <th>Hình ảnh</th>
                <th>@Html.DisplayNameFor(model => model.TenHh)</th>
                <th>@Html.DisplayNameFor(model => model.TenAlias)</th>
                <th>@Html.DisplayNameFor(model => model.MoTaDonVi)</th>
                <th>@Html.DisplayNameFor(model => model.DonGia)</th>
                <th>@Html.DisplayNameFor(model => model.NgaySx)</th>
                <th>@Html.DisplayNameFor(model => model.GiamGia)</th>
                <th>@Html.DisplayNameFor(model => model.SoLanXem)</th>
                <th>@Html.DisplayNameFor(model => model.MoTa)</th>
                <th>Loại hàng</th>
                <th>Nhà cung cấp</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Hinh))
                        {
                            <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh" width="60" height="60" class="img-thumbnail" style="object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </td>
                    <td>@item.TenHh</td>
                    <td>@item.TenAlias</td>
                    <td>@item.MoTaDonVi</td>
                    <td>@item.DonGia?.ToString("N0") ₫</td>
                    <td>@item.NgaySx.ToString("dd/MM/yyyy")</td>
                    <td>@item.GiamGia.ToString("P0")</td>
                    <td>@item.SoLanXem</td>
                    <td>@item.MoTa</td>
                    <td>@item.MaLoaiNavigation?.TenLoai</td>
                    <td>@item.MaNccNavigation?.TenCongTy</td>
                    <td>
                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-outline-warning mb-1">Sửa</a>
                        <a asp-controller="Admin" asp-action="Details" asp-route-id="@item.MaHh" class="btn btn-sm btn-outline-info mb-1">Chi tiết</a>
                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@item.MaHh" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa hàng hóa này?')">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
